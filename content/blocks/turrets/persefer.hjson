type: ItemTurret
name: Persefer
description: Pháo phòng không Gatling siêu việt 6 nòng. Càng xả đạn liên tục, tốc độ bắn và chu kỳ xoay nòng càng được đẩy lên cực hạn.
size: 4
health: 3200
range: 900

reload: 0.5
recoil: 0.3
shake: 1
inaccuracy: 4
shootCone: 15
rotateSpeed: 6.5

shootWarmupSpeed: 0.02
minWarmup: 0.0
linearWarmup: true

targetGround: false
targetAir: true

requirements: [
  copper/250
  lead/200
  silicon/150
  titanium/100
]

ammoTypes: {
  copper: {
    type: BasicBulletType
    speed: 12
    damage: 22
    width: 7
    height: 14
    lifetime: 75
    ammoMultiplier: 2
  }
  graphite: {
    type: BasicBulletType
    speed: 14
    damage: 35
    width: 8
    height: 16
    lifetime: 65
    ammoMultiplier: 3
    reloadMultiplier: 0.8
  }
  silicon: {
    type: BasicBulletType
    speed: 13
    damage: 26
    width: 7
    height: 14
    homingPower: 0.12
    homingRange: 120
    lifetime: 70
    ammoMultiplier: 3
  }
}

category: turret
research: cyclone

