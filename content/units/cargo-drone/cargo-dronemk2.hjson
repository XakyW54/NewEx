type: flying
name: Cargo Drone Mk2
description: Drone chiến đấu cao cấp bắn ra quả cầu năng lượng quang phổ đa sắc.
flying: true
lowAltitude: true
speed: 3.5
accel: 0.1
drag: 0.05
health: 420
armor: 4
hitSize: 8

itemCapacity: 30
isEnemy: false
mineTier: 0
buildSpeed: 0

logicControllable: true
playerControllable: false

engineOffset: 5.5
engineSize: 2
drawCell: false

weapons: [
  {
    name: avert-weapon
    reload: 120
    x: 0
    y: 7.25
    layerOffset: -0.01
    rotate: false
    mirror: false
    recoil: 1
    shootY: 5
    top: false
    shootSound: laser
    inaccuracy: 5

    # ĐẠN BẮN RA NGUYÊN BẢN TỪ PHÁO BAYROWFYR
    bullet: {
      type: BasicBulletType
      sprite: large-orb
      speed: 4.5
      damage: 120
      lifetime: 72
      width: 18
      height: 18
      collidesGround: true
      collidesAir: true
      frontColor: ffffff
      backColor: "00000000"
      lightColor: ffffff
      shrinkX: 0
      shrinkY: 0
      trailEffect: missileTrail
      trailInterval: 3
      trailColor: ffffff
      trailWidth: 3
      trailLength: 15

      # Hiệu ứng đổi màu vòng tròn RGB
      parts: [
        {
          type: RegionPart
          layer: 100.1
          name: large-orb
          outline: false
          color: ffffff
          xScl: 0.8
          yScl: 0.8
        }
        {
          type: RegionPart
          layer: 100
          name: large-orb-back
          outline: false
          color: ff6060
          colorTo: 60ff60
          xScl: 0
          yScl: 0
          progress: {
            type: time
            ops: [
              { op: loop, time: 90 }
              { op: compress, start: 0, end: 0.3333 }
            ]
          }
        }
        {
          type: RegionPart
          layer: 100
          name: large-orb-back
          outline: false
          color: 60ff60
          colorTo: 6060ff
          xScl: 0
          yScl: 0
          progress: {
            type: time
            ops: [
              { op: loop, time: 90 }
              { op: compress, start: 0.3333, end: 0.6666 }
            ]
          }
        }
        {
          type: RegionPart
          layer: 100
          name: large-orb-back
          outline: false
          color: 6060ff
          colorTo: ff6060
          xScl: 0
          yScl: 0
          progress: {
            type: time
            ops: [
              { op: loop, time: 90 }
              { op: compress, start: 0.6666, end: 1 }
            ]
          }
        }
      ]

      # Bắn ra sét 6 màu trên đường bay
      bulletInterval: 3
      intervalBullet: {
        type: MultiBulletType
        damage: 18
        status: shocked
        statusDuration: 15
        bullets: [
          { type: LightningBulletType, damage: 18, lightningColor: ff6060, lightningLength: 4, lightningLengthRand: 6 }
          { type: LightningBulletType, damage: 18, lightningColor: ffff60, lightningLength: 4, lightningLengthRand: 6 }
          { type: LightningBulletType, damage: 18, lightningColor: 60ff60, lightningLength: 4, lightningLengthRand: 6 }
          { type: LightningBulletType, damage: 18, lightningColor: 60ffff, lightningLength: 4, lightningLengthRand: 6 }
          { type: LightningBulletType, damage: 18, lightningColor: 6060ff, lightningLength: 4, lightningLengthRand: 6 }
          { type: LightningBulletType, damage: 18, lightningColor: ff60ff, lightningLength: 4, lightningLengthRand: 6 }
        ]
      }

      # Nổ sắc màu và phát tán sét khi trúng đích
      hitEffect: [
        { type: ExplosionEffect, sparkColor: ff6060, smokeColor: ff6060, waveColor: ff6060, waveRad: 30, waveLife: 8 }
        { type: ExplosionEffect, sparkColor: ffff60, smokeColor: ffff60, waveColor: ffff60, waveRad: 35, waveLife: 10 }
        { type: ExplosionEffect, sparkColor: 60ff60, smokeColor: 60ff60, waveColor: 60ff60, waveRad: 40, waveLife: 12 }
        { type: ExplosionEffect, sparkColor: 60ffff, smokeColor: 60ffff, waveColor: 60ffff, waveRad: 45, waveLife: 14 }
        { type: ExplosionEffect, sparkColor: 6060ff, smokeColor: 6060ff, waveColor: 6060ff, waveRad: 50, waveLife: 16 }
        { type: ExplosionEffect, sparkColor: ff60ff, smokeColor: ff60ff, waveColor: ff60ff, waveRad: 55, waveLife: 18 }
      ]
      fragBullets: 1
      fragOnHit: true
      fragOnDespawn: true
      fragBullet: {
        type: MultiBulletType
        bullets: [
          { type: LightningBulletType, lightningColor: ff6060, damage: 25, lightningLength: 6, lightningLengthRand: 8 }
          { type: LightningBulletType, lightningColor: ffff60, damage: 25, lightningLength: 6, lightningLengthRand: 8 }
          { type: LightningBulletType, lightningColor: 60ff60, damage: 25, lightningLength: 6, lightningLengthRand: 8 }
          { type: LightningBulletType, lightningColor: 60ffff, damage: 25, lightningLength: 6, lightningLengthRand: 8 }
          { type: LightningBulletType, lightningColor: 6060ff, damage: 25, lightningLength: 6, lightningLengthRand: 8 }
          { type: LightningBulletType, lightningColor: ff60ff, damage: 25, lightningLength: 6, lightningLengthRand: 8 }
        ]
      }
    }
  }
]